# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server: serve per inviare notifiche agli altri utenti
SUPABASE_SERVICE_ROLE_KEY=

# Indirizzo pubblico del sito (per i link nelle email)
NEXT_PUBLIC_SITE_URL=https://turni.vercel.app

# Dominio Google aziendale (suggerito nella schermata di login di Google)
NEXT_PUBLIC_GOOGLE_HD=azienda.it

# Email (facoltativo) – https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Turni <turni@azienda.it>"

# Notifiche push (facoltativo) – genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:carlo@azienda.it

# Google Calendar (facoltativo) – stesso client OAuth usato per il login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stringa casuale: protegge la sincronizzazione giornaliera
CRON_SECRET=
# Facoltativa: chiave per cifrare i token del calendario (se assente usa la service role key)
CALENDAR_TOKEN_KEY=
